PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=library_database
# Set true in production when the MySQL CA is trusted (Azure/MySQL Flexible Server, etc.)
DB_SSL_REJECT_UNAUTHORIZED=false

# At least 32 random characters in production. Never reuse the placeholder values.
SESSION_SECRET=replace-with-a-long-random-secret
# Required in production; must differ from SESSION_SECRET (also >= 32 chars).
PASSWORD_RESET_SECRET=replace-with-a-different-long-random-secret
SESSION_MAX_AGE_SECONDS=43200
PASSWORD_RESET_MAX_AGE_SECONDS=1800

# Browser origins allowed to call this API (comma-separated). Required in production.
# Example Azure SWA: https://<your-app>.azurestaticapps.net
APP_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN=
CORS_ALLOWED_ORIGINS=

# Optional stable public API origin for uploaded image URLs (recommended on Render).
# Example: https://library-database-baclend-api.onrender.com
BACKEND_PUBLIC_ORIGIN=

# Leave headroom for 5 MB image uploads sent as base64 data URLs (~7mb).
JSON_BODY_LIMIT=7mb

TRUST_PROXY_HOPS=1
